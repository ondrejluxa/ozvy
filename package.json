{
  "name": "navrat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:supabase": "node scripts/dev/next-with-env.mjs .env.supabase.local dev -p 3001",
    "env:local": "tsx scripts/dev/env-local.ts",
    "admin:create": "tsx --env-file=.env.supabase.local scripts/dev/create-admin.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "playwright test --config playwright.supabase.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm db:test:local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "tsx --env-file=.env.supabase.local supabase/seed/seed.ts",
    "db:fixtures": "tsx scripts/db/generate-fixtures.ts",
    "db:test": "supabase test db",
    "db:test:local": "tsx scripts/db/pglite-test.ts",
    "db:types": "supabase gen types typescript --local --schema public > lib/db/types.gen.ts && prettier --write lib/db/types.gen.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "inngest": "^4.25.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.14",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
