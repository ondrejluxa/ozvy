# All variables are validated at server start by lib/env/schema.ts (spec §39).
# Names only; never commit values. The defaults run the labelled sales demo.

# ---- App ----
APP_ENV=local                        # local | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPT_OUT_BASE_URL=example.cz/o        # short opt-out domain shown in SMS (no scheme)

# ---- Data ----
DATA_SOURCE=demo                     # demo (in-memory seed) | supabase (real MVP)
# DEMO_MODE is derived from DATA_SOURCE; demo data can never be shown unlabelled.

# ---- Supabase (required with DATA_SOURCE=supabase) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server + jobs only
SUPABASE_DB_URL=                     # migrations / backups only, CI secret

# ---- Jobs (required in production) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
JOB_RUNNER=inline                    # inline (local, CI) | inngest (required in production)

# ---- Messaging ----
SMS_PROVIDER=mock                    # mock | bulkgate; non-production needs SMS_TEST_WHITELIST
SMS_PROVIDER_API_KEY=                # BulkGate application_id
SMS_PROVIDER_API_SECRET=             # BulkGate application_token
SMS_WEBHOOK_SECRET=                  # 32+ chars; DLR URL: /api/webhooks/sms/<provider>?secret=...
SMS_TEST_WHITELIST=                  # comma-separated E.164 numbers allowed for real sends outside production
SMS_RATE_PER_SECOND=10                # dispatcher rate limit (messages per second)
SMS_PRICE_PER_SEGMENT_MINOR=90       # CZK haléře per segment for cost figures
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Návrat <no-reply@example.com>"

# ---- AI ----
AI_PROVIDER=mock                     # mock | openai | anthropic
AI_MODEL=
AI_API_KEY=

# ---- Security ----
SUPPRESSION_PEPPER=                  # 32+ random bytes, base64; never rotate without re-hashing
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Local development only (written by `pnpm env:local`, never set elsewhere) ----
# DEV_ALLOW_REAL_LOOKING_DATA=false  # importer: allow non-example.* e-mails for one specific test
# SEED_USER_PASSWORD=                # password of the seeded example.cz accounts (pnpm db:seed)

# ---- Monitoring ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
